{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "commitMessagePrefix": "DEP: ",
  "rangeStrategy": "replace",
  "timezone": "America/New_York",
  "assignees": ["jshn9515"],
  "addLabels": ["dependencies", "python"],
  "packageRules": [
    {
      "groupName": "PyTorch packages",
      "matchPackageNames": ["torch", "torchvision", "torchaudio"]
    },
    {
      "description": "Ignore patch updates for the Quarto Docker image",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/quarto-dev/quarto"],
      "matchUpdateTypes": ["patch"],
      "enabled": false
    },
    {
      "description": "Ignore patch updates for the Python packages",
      "matchManagers": ["pep621"],
      "matchUpdateTypes": ["patch"],
      "enabled": false
    },
    {
      "description": "Ignore patch and minor updates for GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor"],
      "enabled": false
    }
  ]
}
